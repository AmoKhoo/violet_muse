# Violet — copy to .env.local (local) or set in Vercel → Project Settings → Environment Variables.
# Node 18+ is the only requirement. No external services are needed to run.

# --- Optional integrations (placeholders until you add keys) ---
# OpenAI — when set, test reports are generated by the OpenAI API;
# when empty, reports are generated locally from the test's answer key + prompt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments — when set, checkout goes through Stripe; when empty, checkout is a
# clearly-labelled DEMO checkout that records the order without charging a card.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Google — when set, bookings create a real Google Meet link and Calendar event;
# when empty, bookings get a clearly-labelled placeholder Meet link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Sessions are signed with this secret (change it in production).
SESSION_SECRET=violet-dev-secret-change-me

# Data storage. Locally the JSON database lives in ./data/violet.json.
# On Cloudflare Pages / Vercel (serverless) there is no persistent
# filesystem: the database lives in memory only and does NOT persist
# between deployments — for durable production data, set DATABASE_URL
# (Postgres, e.g. Neon / Supabase) and see docs/ARCHITECTURE.md.
DATA_DIR=
DATABASE_URL=

# Demo accounts (seeded on first boot). Change DEMO_PASSWORD before launch.
DEMO_PASSWORD=demo1234
